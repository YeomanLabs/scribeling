# Normalise line endings so the repo is identical regardless of who clones it.
* text=auto eol=lf

# PowerShell 5.1 is happiest with CRLF, and some older parsers choke on LF in
# multi-line here-strings, so keep these native to Windows.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Everything else stays LF.
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.txt text eol=lf

# Binary - never touch.
*.png binary
*.ico binary
*.exe binary
*.skill binary
*.zip binary
